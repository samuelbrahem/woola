# Google Maps JS API key (Maps JavaScript API enabled, HTTP-referrer restricted to woola.ca)
# Without it, the site falls back to the Leaflet/OpenStreetMap coverage map.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Places API (New) server key for the live review cards (lib/google-reviews.ts).
# Enable "Places API (New)" on the key; restrict by IP, not HTTP referrer.
# Without it the review bands show only the "See our Google reviews" link.
GOOGLE_PLACES_API_KEY=
# Optional: pin a division's listing instead of finding it by name.
# GOOGLE_PLACE_ID_MECHANICAL=
# GOOGLE_PLACE_ID_POWER=

# Resend API key for the Second Opinion upload form (resend.com)
# Without it, /api/second-opinion returns a friendly "call us" message.
RESEND_API_KEY=

# Where Second Opinion submissions are delivered
ESTIMATING_EMAIL=services@woola.ca

